# 复制为 .env 后按需修改：cp .env.example .env

# ---------- MySQL（仅 Docker 线上部署使用） ----------
# 测试环境不启动此容器，后端直接连本机 3306（代码默认值）
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=boardgame
# MySQL 容器对外映射到宿主机的端口（容器内仍是 3306）
MYSQL_PORT=4768

# ---------- 后端 ----------
BACKEND_PORT=5050
# 同源反代时保持 *；若前端直连后端域，请改为具体来源，如 https://example.com
CORS_ORIGIN=*

# ---------- 前端 ----------
FRONTEND_PORT=5000

# ---------- 其他 ----------
TZ=Asia/Shanghai
